# Environment variables for MoodJournal MVP
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Compatible API Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Alternative models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Alternative endpoints:
# OPENAI_BASE_URL=https://your-custom-endpoint.com/v1

# OpenAI Transcription Configuration
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Available transcription models: gpt-4o-mini-transcribe, whisper-1

# OpenWeatherMap API Configuration
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
# Get your free API key from: https://openweathermap.org/api
# Free tier includes: 1,000 calls/day, current weather, 5-day forecast, historical data (last 5 days)

# Supabase Storage Configuration
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=audio-recordings

# Application Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key


# Development
NODE_ENV=development